# Copy to .env. The app refuses to start if a required variable is missing (src/env.ts).

# PostgreSQL. DIRECT_URL is the non-pooled connection used by migrations (same value in development).
DATABASE_URL="postgresql://gestoria:gestoria@localhost:5433/gestoria"
DIRECT_URL="postgresql://gestoria:gestoria@localhost:5433/gestoria"

REDIS_URL="redis://localhost:6379"

# openssl rand -base64 32
AUTH_SECRET="change-me-change-me-change-me-change-me"

# Base domain of the platform. Tenants live on <slug>.<APP_DOMAIN> or on their verified custom domain.
APP_DOMAIN="localhost:3000"
# Optional: serve one tenant on the bare APP_DOMAIN. Leave empty to reach the platform (sign-up, superadmin) there.
DEFAULT_TENANT_SLUG=""

# S3-compatible storage (MinIO in development, Cloudflare R2 in production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="gestoria"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Optional. Without RESEND_API_KEY emails are stored in email_log and printed to the console.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@localhost"

# ClamAV (docker compose --profile antivirus up -d). Empty = fake scanner that only flags the EICAR test file.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Inbound email (Resend). Empty secret = the webhook only accepts the development payload, never in production.
RESEND_WEBHOOK_SECRET=""
INBOUND_EMAIL_DOMAIN="docs.localhost"

# AI extraction (Anthropic). Empty = development extractor that only understands the synthetic demo invoices.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Custom domains (Vercel). Empty = the domain is verified by TXT but must be attached to the project by hand.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
PLATFORM_CNAME_TARGET="cname.vercel-dns.com"

# Web push. npx web-push generate-vapid-keys. Empty = pushes are logged to the console, not sent.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

DEMO_MODE="true"
SENTRY_DSN=""
